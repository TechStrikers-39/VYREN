# Backend environment variables — EXAMPLE TEMPLATE
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Frontend origin(s) for CORS and OAuth redirects (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Gemini AI (Phase 9)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Live iGOT Karmayogi / Sunbird API integration
# IGOT_API_URL=https://portal.igotkarmayogi.gov.in
# IGOT_AUTH_TOKEN=your_igot_auth_token_here
# IGOT_CLIENT_ID=your_client_id_here
# IGOT_CLIENT_SECRET=your_client_secret_here
# IGOT_CHANNEL=igot
